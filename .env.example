# Option 1: OpenAI (or any OpenAI-compatible cloud provider)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# Option 2: Local models with Ollama (no paid API key required)
# Start Ollama first (`ollama serve` and `ollama pull llama3.2`), then uncomment:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3.2

# Optional: Force offline deterministic demo mode across supported examples
# AGENT_DEMO_MODE=1
